{
  "description": "Project-local Codex guards shipped by Orchestra. Package rails only — a host adds its own rows beside these (never inside them). Review and trust these definitions before relying on live enforcement.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/run-source-hook.sh\" .claude/hooks/block-dangerous.py", "timeout": 10 },
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/require-open-run.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/require-open-run.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/worker-guard.py\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.py\"", "timeout": 10, "additionalContextLimit": 500 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent-start.py\"", "timeout": 10, "additionalContextLimit": 1000 }
        ]
      }
    ]
  }
}
