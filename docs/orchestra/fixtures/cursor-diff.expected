-def delivery():
-    try:
-        with open(".orchestra/delivery.json") as f:
-            return json.load(f)
-    except Exception:
-        return {}
-
-
-PROTECTED = set(delivery().get("protected_branches", ["main", "master"]))
-GIT_VALUE_OPTS = {"-C", "-c", "--git-dir", "--work-tree", "--exec-path", "--namespace"}
