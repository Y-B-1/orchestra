-
-
-def check_line(line):
-    if re.search(r"\b(curl|wget)\b[^|;&]*\|\s*(ba|z|da|k)?sh\b", line):
-        respond("deny", "piping a download into a shell")
-    # Whole-line parse first: shlex keeps quoted payloads (with ; inside) intact,
