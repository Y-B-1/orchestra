<         else:
<             how = (
<                 "## How to fill\n\n"
<                 "- topic · path · as-of date · one-line lesson. Prune stale "
<                 "entries. Git is history.\n\n"
<             )
<         write(path, how + text.lstrip())
<         log(f"prepended How to fill on {path}")
< 
