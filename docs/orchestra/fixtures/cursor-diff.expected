-        return
-
-    if prog in ("sh", "bash", "zsh", "dash", "ksh", "python", "python3", "node") :
-        for j, t in enumerate(tokens):
-            if t == "-c" and j + 1 < len(tokens):
-                check_line(tokens[j + 1])
-        return
-
-    if prog == "git":
-        sub, args = analyze_git(tokens)
-        if sub is None:
-            return
-        flags = [a for a in args if a.startswith("-")]
